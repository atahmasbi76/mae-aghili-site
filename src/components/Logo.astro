---
// Draft logo: a fine-line tooth inside an arch, with a serif wordmark.
const { size = 40, withText = true } = Astro.props;
---
<span class="logo">
  <svg class="logo-mark" width={size} height={size} viewBox="0 0 40 40" aria-hidden="true">
    <path d="M4 38V18a16 16 0 0 1 32 0v20" fill="none" stroke="var(--accent)" stroke-width="1.4" />
    <path
      d="M15 13.5c-2.9 0-4.8 2.1-4.8 5.3 0 2.1.8 3.5 1.3 5.4.6 2.4.9 6.3 3 6.3 1.7 0 1.6-4 4.5-4s2.8 4 4.5 4c2.1 0 2.4-3.9 3-6.3.5-1.9 1.3-3.3 1.3-5.4 0-3.2-1.9-5.3-4.8-5.3-1.7 0-2.6.9-4 .9s-2.3-.9-4-.9z"
      fill="none" stroke="var(--ink)" stroke-width="1.4" stroke-linejoin="round"
    />
    <path d="M31 6.5l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7z" fill="var(--second)" />
  </svg>
  {withText && (
    <span class="logo-text">
      <span class="logo-name">Mae Aghili<span class="logo-dds">, DDS</span></span>
      <span class="logo-sub">Pediatric Dentistry</span>
    </span>
  )}
</span>
